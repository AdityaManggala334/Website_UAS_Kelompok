{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/api/login.php" },
    { "source": "/register", "destination": "/api/login.php?tab=register" },
    { "source": "/dashboard", "destination": "/api/dashboard.php" },
    { "source": "/riwayat", "destination": "/api/riwayat.php" },
    { "source": "/daftar-alat", "destination": "/api/daftar_alat.php" }
  ]
}
