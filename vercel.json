{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "@vercel/php@1.0.0"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/login",
      "dest": "/api/login.php"
    },
    {
      "src": "/register",
      "dest": "/api/login.php?tab=register"
    },
    {
      "src": "/dashboard",
      "dest": "/api/dashboard.php"
    },
    {
      "src": "/riwayat",
      "dest": "/api/riwayat.php"
    },
    {
      "src": "/daftar-alat",
      "dest": "/api/daftar_alat.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
